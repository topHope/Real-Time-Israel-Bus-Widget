<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#000000"
        app:cardCornerRadius="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <Button
                android:id="@+id/ChangeButton"
                style="@style/Widget.AppCompat.Button"
                android:layout_width="60dp"
                android:layout_height="50dp"
                android:text="+"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/RemoveStationButton"
                style="@style/Widget.AppCompat.Button"
                android:layout_width="60dp"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:text="x"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ChangeButton" />

            <ImageView
                android:id="@+id/StationImage"
                android:layout_width="90dp"
                android:layout_height="90dp"
                tools:srcCompat="@tools:sample/avatars" />

            <TextView
                android:id="@+id/StationName"
                android:layout_width="241dp"
                android:layout_height="35dp"
                android:layout_marginStart="16dp"
                android:text="Station Name"
                android:textColor="#EBEBEB"
                android:textSize="24sp"
                app:layout_constraintStart_toEndOf="@+id/StationImage"
                tools:layout_editor_absoluteY="16dp" />

            <TextView
                android:id="@+id/StationID"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="ID: #####"
                android:textColor="#FAFAFA"
                app:layout_constraintStart_toStartOf="@+id/StationName"
                app:layout_constraintTop_toBottomOf="@+id/StationName" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/Station_BusRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="60dp"
                android:layout_marginTop="116dp"
                android:layout_marginBottom="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>